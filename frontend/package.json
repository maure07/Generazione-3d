{
  "name": "printready-ai",
  "productName": "PrintReady AI",
  "version": "1.0.0",
  "description": "Da immagine + descrizione a modello 3D pronto per la stampa FDM",
  "main": "dist-electron/main.js",
  "author": "PrintReady AI Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64",
    "lint": "eslint src electron --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "ai.printready.desktop",
    "productName": "PrintReady AI",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!**/__pycache__/**", "!.venv/**"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "PrintReadyAI-${version}-win64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PrintReady AI"
    }
  }
}
