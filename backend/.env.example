# Configurazione di PrintReady AI
# ---------------------------------------------------------------------------
# Copiare questo file in `.env` e compilare i valori necessari.
# L'applicazione funziona anche senza alcuna chiave: in quel caso usa il
# generatore locale, che non richiede rete.

# --- Provider di generazione 3D --------------------------------------------
# PRINTREADY_TRIPO_API_KEY=
# PRINTREADY_MESHY_API_KEY=
# PRINTREADY_HUNYUAN_ENDPOINT=http://127.0.0.1:8080
# PRINTREADY_HUNYUAN_API_KEY=

# Tempo massimo di attesa di un provider cloud, in secondi.
# PRINTREADY_AI_TIMEOUT_S=900

# --- Server ----------------------------------------------------------------
# PRINTREADY_HOST=127.0.0.1
# PRINTREADY_PORT=8765
# PRINTREADY_LOG_LEVEL=INFO

# --- Cartella dati ---------------------------------------------------------
# Predefinita: %LOCALAPPDATA%\PrintReadyAI su Windows.
# PRINTREADY_DATA_DIR=

# --- Calcolo ---------------------------------------------------------------
# PRINTREADY_USE_GPU=true
# PRINTREADY_CUDA_DEVICE=0
# PRINTREADY_MAX_PARALLEL_JOBS=2

# --- Funzionalità ----------------------------------------------------------
# PRINTREADY_AUTOSAVE_INTERVAL_S=20
# PRINTREADY_HISTORY_LIMIT=0        # 0 = cronologia illimitata
# PRINTREADY_ENABLE_PLUGINS=true

# --- Aggiornamenti automatici ----------------------------------------------
# PRINTREADY_ENABLE_OTA=true
# PRINTREADY_OTA_MANIFEST_URL=https://esempio.it/printready/manifest.json
